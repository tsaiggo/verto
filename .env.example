# Verto content source
#
# Verto reads Markdown and MDX files from a configured source. The desktop
# product uses Local Library and RSS; OneDrive remains available for static
# source builds.

# local (default) | onedrive
VERTO_CONTENT_SOURCE=local

# Local source
# VERTO_LOCAL_DIR=content

# AI assistant
#
# The assistant is off until it is configured. The current provider is GitHub
# Models. Add the model token manually in Settings > AI & Agent; it is stored
# only in localStorage on the current device.
#
# none (default) | github (aliases: copilot, github-models)
# NEXT_PUBLIC_VERTO_ASSISTANT=github
# NEXT_PUBLIC_VERTO_ASSISTANT_MODEL=openai/gpt-4o-mini

# OneDrive source
#
# Share-URL mode:
# VERTO_ONEDRIVE_SHARE_URL=https://1drv.ms/u/s!...
# VERTO_ONEDRIVE_PATH=content

# Private content:
# VERTO_ONEDRIVE_TENANT=common
# VERTO_ONEDRIVE_CLIENT_ID=
# VERTO_ONEDRIVE_CLIENT_SECRET=
# VERTO_ONEDRIVE_REFRESH_TOKEN=
# VERTO_ONEDRIVE_PATH=content

# Web Mail (public OAuth app IDs; no client secrets)
# NEXT_PUBLIC values are embedded at build time; rebuild/redeploy after changing IDs.
# Use a fixed HTTPS origin (or localhost for development), not a plain HTTP LAN IP.
# Google: Web application client, Gmail API, exact Authorized JavaScript origin (no /mail).
# Microsoft: SPA registration, exact redirect URI <origin>/mail (no query/fragment).
# Connect requests Gmail readonly / Graph Mail.Read + User.Read.
# Message actions add gmail.modify / delegated Mail.ReadWrite on an explicit action click.
# Enable sending adds gmail.send / delegated Mail.Send separately; Send remains explicit.
# Google Testing requires allowed test users; Microsoft test accounts must match app audience.
# Setup and real-account checks: docs/mail-live-acceptance.md
# NEXT_PUBLIC_VERTO_MAIL_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_VERTO_MAIL_MICROSOFT_CLIENT_ID=
